# Copy this file to .env and fill in real values.
# NEVER commit .env or paste these values into a chat.

# --- Mode ---
PAPER_MODE=true

# --- Anthropic (Researcher) ---
ANTHROPIC_API_KEY=

# --- OpenAI (QC / Fact-Checker) ---
OPENAI_API_KEY=

# --- Google AI Studio (Auditor) ---
GOOGLE_API_KEY=

# --- Zerodha Kite Connect (Trader + market data) ---
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# --- Gmail (alerts + approve/reject) ---
# 1. Enable 2-Step Verification on your Google account
# 2. Go to myaccount.google.com/apppasswords → create an App Password for "Mail"
# 3. Paste the 16-char password below (no spaces)
GMAIL_APP_PASSWORD=
ALERT_EMAIL=you@gmail.com
# Your Railway deployment URL (no trailing slash)
RAILWAY_URL=https://your-app.railway.app
# Random secret for signing approve/reject links — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
APPROVAL_SECRET=

# --- Model identifiers (override if a newer version is available) ---
RESEARCHER_MODEL=claude-sonnet-5
QC_MODEL=gpt-5.5
AUDITOR_MODEL=gemini-3.5-pro

# --- Risk limits (enforced by risk_sizer, not the Researcher) ---
MAX_POSITION_PCT_OF_CAPITAL=20
MAX_WEEKLY_DRAWDOWN_PCT=10
TOTAL_CAPITAL_INR=1000000

# --- Universe ---
# Path to your weekly Screener.in CSV export (relative to project root).
# Refresh this every Sunday before the week's first market session.
UNIVERSE_CSV_PATH=universe/universe.csv

# --- Google Sheets trade logger (optional) ---
# OAuth2 setup (GCP project + Sheets API + Drive API already configured):
# 1. Run once: python setup/authorize_sheets.py
#    A browser tab opens → log in → token saved to credentials/authorized_user.json
# 2. Create a Google Sheet, copy its ID from the URL, paste below.
# Paths below are relative to the project root.
SHEETS_OAUTH_CLIENT_PATH=credentials/oauth_client.json
SHEETS_AUTHORIZED_USER_PATH=credentials/authorized_user.json
SHEETS_SPREADSHEET_ID=

# --- Portfolio risk limits (enforced by portfolio_risk.py) ---
MAX_DRAWDOWN_PCT=8.0
MAX_DEPLOYED_PCT=65.0
WEEKLY_LOSS_LIMIT_INR=-15000
MAX_OPEN_POSITIONS=6
MAX_SECTOR_PCT=30.0
