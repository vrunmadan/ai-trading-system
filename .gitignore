# Environment variables — NEVER commit
.env

# OAuth credentials and tokens — NEVER commit
credentials/
!credentials/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/
.pytest_cache/

# SQLite ledger (local state — not for version control)
ledger/*.db

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# gstack local artifacts (security reports, etc.) — never commit
.gstack/
