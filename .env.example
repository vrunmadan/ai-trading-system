# AI Trading System — environment configuration
#
# Generated from the code's actual os.getenv() calls. Every variable the
# system reads is listed here with its code default; values shown are the
# defaults, so an unset variable behaves exactly as written below.
#
# Copy to .env for local runs, or set these in Railway → Variables.
# .env is git-ignored. Never commit real keys.

# =============================================================================
# MODE
# =============================================================================

# PAPER logs simulated fills and reconciles them without contacting Kite.
# LIVE reconciles against your real Kite positions and holdings.
# NOTE: this does NOT currently gate the approval path — approving a signal
# opens a real pre-filled Kite basket either way. Only you tapping Place Order
# in Kite moves money. See TODOS.md.
PAPER_MODE=true


# =============================================================================
# API KEYS — required
# =============================================================================

# Researcher (signal synthesis). Without this, no signals are generated.
ANTHROPIC_API_KEY=

# QC fact-checker (adversarial review). Without this — or without QUOTA on the
# account — every signal is blocked at the QC gate and no trade ever ships.
# /status reports this under llm_providers.
OPENAI_API_KEY=

# Weekly Auditor (calibration review). Non-critical: losing it costs analysis,
# not trades.
GOOGLE_API_KEY=

# Zerodha Kite Connect — market data and order routing.
# The historical-data add-on is a paid tier and is required.
KITE_API_KEY=
KITE_API_SECRET=
# Fallback only. The daily token is normally stored in the ledger by the
# /kite_callback flow and preferred over this.
KITE_ACCESS_TOKEN=
# Only used by setup/setup_kite_auth.py.
KITE_USER_ID=


# =============================================================================
# EMAIL (Resend) — required
#
# Alerts go out over the Resend HTTP API on port 443. There is no SMTP path
# and no Gmail app password anywhere in the code.
# =============================================================================

RESEND_API_KEY=
ALERT_EMAIL=
# The default only delivers to the address you signed up to Resend with.
# Verify a domain at resend.com/domains and use trading@yourdomain.com.
RESEND_FROM=AI Trading System <onboarding@resend.dev>

# Public base URL of the deployment. Used to build approve/reject links, so a
# wrong value produces links that go nowhere.
RAILWAY_URL=

# Signs the HMAC on approve/reject links. If unset, verify_token fails closed
# and EVERY approve/reject link stops working — alerts arrive but cannot be
# acted on. Use a long random string.
APPROVAL_SECRET=

# Guards the diagnostic endpoints (/status, /cycle_history, /diagnose_*,
# /refresh_universe, /send_test_email). Keep it SEPARATE from APPROVAL_SECRET:
# it travels in the URL query string and so lands in access logs and browser
# history, and sharing one key would make that leak enough to forge trade
# approvals. Falls back to APPROVAL_SECRET when unset, with a startup warning.
DIAGNOSTIC_SECRET=


# =============================================================================
# MODELS
# =============================================================================

RESEARCHER_MODEL=claude-sonnet-5
QC_MODEL=gpt-5.5
AUDITOR_MODEL=gemini-3.5-pro


# =============================================================================
# STORAGE
# =============================================================================

# SQLite ledger: signals, trades, position checks, cycle log, weekly audits,
# the portfolio peak, and the stored Kite token.
# On Railway this MUST point at a mounted volume. On the container filesystem
# it is wiped by every deploy, silently taking all history with it.
LEDGER_DB_PATH=ledger/trading_ledger.db

PORT=8080


# =============================================================================
# PORTFOLIO RISK GATE (risk_manager/portfolio_risk.py)
#
# Runs first in every cycle. Any breach halts the whole cycle.
# =============================================================================

TOTAL_CAPITAL_INR=1000000

# Halt if the portfolio falls this far below its all-time peak.
# Computed from REALISED P&L only, so an open position down 40% does not
# move it. See TODOS.md.
MAX_DRAWDOWN_PCT=8.0

# Halt if this share of capital is already deployed.
MAX_DEPLOYED_PCT=65.0

# Halt for the rest of the week below this realised P&L.
WEEKLY_LOSS_LIMIT_INR=-15000

# Halt at this many open positions.
MAX_OPEN_POSITIONS=6

# Halt if any one sector exceeds this share of TOTAL capital.
# This is the binding sector limit: the sizer clamps itself to the tighter of
# this and MAX_SECTOR_PCT_OF_CAPITAL.
MAX_SECTOR_PCT=30.0


# =============================================================================
# RISK SIZER (risk_sizer/sizer.py)
#
# Per-signal sizing, after the portfolio gate has already passed.
# =============================================================================

# Base position as a share of capital, before confidence scaling
# (70% confidence -> 0.60x, 100% -> 1.00x).
MAX_POSITION_PCT_OF_CAPITAL=20

# Per-trade sector ceiling. The sizer clamps itself to the TIGHTER of this
# and MAX_SECTOR_PCT, so it can never build a position that trips the
# portfolio gate and halts the next cycle. Setting this above MAX_SECTOR_PCT
# logs a warning and has no effect.
MAX_SECTOR_PCT_OF_CAPITAL=35

MAX_WEEKLY_DRAWDOWN_PCT=10
MAX_CONCURRENT_POSITIONS=5

# Below this, a position is not worth the transaction cost.
MIN_POSITION_INR=10000


# =============================================================================
# RESEARCHER / REGIME (researcher/)
# =============================================================================

# Claude's composite confidence must reach this to produce a signal.
MIN_SIGNAL_CONFIDENCE=75

# Consecutive matching reads required before the regime switches (anti-whipsaw).
# Held in memory, so a redeploy resets it.
REGIME_INERTIA_PERIODS=2

# How many names the breadth reading samples. The sample is stratified across
# the whole cap-ordered universe, not its head.
BREADTH_SAMPLE_SIZE=20


# =============================================================================
# EXIT / MONITOR (monitor/position_monitor.py)
#
# Backtest-validated: 20% trailing beat 7% trailing and both time exits, and
# a profit target reduced expectancy, so there is none.
# =============================================================================

# Hard stop from entry.
LONG_STOP_LOSS_PCT=7.0

# Trailing stop from the peak seen so far. The effective stop is the HIGHER
# of the two.
TRAILING_STOP_PCT=20.0

# Warn when a position is down this much from entry.
WEAKENING_ALERT_PCT=3.0


# =============================================================================
# TRADE RECONCILIATION (monitor/trade_reconciler.py)
# =============================================================================

# Days a LIVE approved order stays PENDING before being written off as never
# placed. Calendar days, so a Friday approval is judged on Monday.
MAX_PENDING_AGE_DAYS=2


# =============================================================================
# QC HEALTH (main.py, monitor/provider_health.py)
# =============================================================================

# Consecutive QC failures before one ops alert goes out. The per-signal
# "trade blocked" alert fires every time regardless.
QC_ERROR_ALERT_THRESHOLD=3

# How long /status caches provider probes, so repeated hits do not spend
# tokens or trip rate limits.
PROVIDER_HEALTH_TTL_SECONDS=300


# =============================================================================
# EXECUTION MICROSTRUCTURE (trader/kite_client.py)
#
# Currently only reachable through execute_trade(), which the approval path
# does not call. See TODOS.md.
# =============================================================================

# Order must be below this share of 20-day average daily volume.
MAX_ADV_PCT=2.0

# Skip if the price is within this much of the day's circuit limit.
CIRCUIT_BUFFER_PCT=1.5

# Skip if 20-day average turnover is below this (3 crore).
MIN_DAILY_TURNOVER_INR=30000000

# Not implemented yet — see TODOS.md.
CORP_ACTION_BLACKOUT_DAYS=3


# =============================================================================
# UNIVERSE DISCOVERY (universe/) — optional, Sunday job only
# =============================================================================

SCREENER_EMAIL=
SCREENER_PASSWORD=
SCREENER_QUERY=ROCE > 20 AND Debt to equity < 0.5 AND Sales growth > 15 AND Market Capitalization > 300
MIN_CANDIDATE_MCAP_CR=500


# =============================================================================
# GOOGLE SHEETS MIRROR (sheets/) — optional, never blocks a cycle
#
# Either the *_B64 pair (base64 of each JSON file, for Railway) or the *_PATH
# pair (local files). B64 wins when both are set.
# =============================================================================

SHEETS_SPREADSHEET_ID=
SHEETS_OAUTH_CLIENT_B64=
SHEETS_AUTHORIZED_USER_B64=
SHEETS_OAUTH_CLIENT_PATH=credentials/oauth_client.json
SHEETS_AUTHORIZED_USER_PATH=credentials/authorized_user.json

# Legacy single-blob form still read by webhook_server.py.
GOOGLE_SHEETS_CREDENTIALS_JSON=
